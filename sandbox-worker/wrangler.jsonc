{
  "name": "dqa-sandbox-runner",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  // Enable Workers Logs / observability — also surfaces container stdout/stderr
  // and the console.error from the runCode try/catch in the dashboard.
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "Sandbox",
      // Reference Cloudflare's pre-built Sandbox image directly so `wrangler
      // deploy` needs NO local Docker. The "-python" variant bundles a Python
      // interpreter (required for runCode with language="python"). Switch back
      // to "./Dockerfile" once you have a Docker engine and want to bake extra
      // packages into the image (e.g. pyodbc/drivers for the DQA pipeline).
      "image": "docker.io/cloudflare/sandbox:0.11.0-python",
      "instance_type": "lite",
      // One container per sandbox session — a cap of 1 means a second session
      // (notebook + gateway + chat UI) hangs forever waiting for capacity.
      "max_instances": 5
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "Sandbox", "name": "Sandbox" }]
  },
  "migrations": [{ "new_sqlite_classes": ["Sandbox"], "tag": "v1" }]
}
