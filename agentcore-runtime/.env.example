# AutoDQA AgentCore Runtime — environment for LOCAL testing (`agentcore launch -l`).
# In the cloud, set the SECRET values from AWS Secrets Manager (see README), and
# the non-secret identifiers as plain runtime env vars.

# --- Bedrock via your PERSONAL Cloudflare AI Gateway (BYOK) -------------------
# The gateway holds the AWS IAM SigV4 keys; the container only sends the token.
# Make sure this gateway's BYOK points at YOUR personal AWS account's Bedrock so
# invocations are billed/served personally.
CF_ACCOUNT_ID=5ed7d6acbe9302af6879cd3c2fda9a85
CF_AIG_GATEWAY=mdecaro001
AWS_REGION=us-east-1
MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
CF_AIG_TOKEN=            # SECRET — cf-aig-authorization bearer

# --- AgentCore Gateway (MCP) + Cognito OAuth ---------------------------------
# NOTE: the values below are the CURRENTLY-DEPLOYED gateway. For personal-account
# testing the Runtime and the Gateway must live in the SAME account — if your
# gateway isn't on your personal account yet, redeploy agentcore-gateway/ there
# and copy these from the new .gateway_config.json.
AGENTCORE_GATEWAY_URL=https://autodqa-gateway-8tf6k75tpz.gateway.bedrock-agentcore.us-east-1.amazonaws.com/mcp
COGNITO_TOKEN_ENDPOINT=https://agentcore-6782ebef.auth.us-east-1.amazoncognito.com/oauth2/token
COGNITO_CLIENT_ID=6o8t2g79ade8ek3i44ij6ebkqb
COGNITO_SCOPE=autodqa-gateway/invoke
COGNITO_CLIENT_SECRET=  # SECRET — Cognito app client secret
